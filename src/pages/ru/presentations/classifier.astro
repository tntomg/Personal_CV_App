---
// Standalone Presentation Mini-App: Rocksurv Classifier
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Rocksurv Classifier — Interactive Petrographic & Structural Suite Presentation</title>
  <meta name="description" content="Interactive presentation of Rocksurv Classifier: IUGS QAPF classification, Schmidt stereonet, structural verification, fault rocks and rock catalog.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    
:root {
  --paper: #f7fafd;
  --ink: #0d1f2d;
  --muted: #4b6377;
  --accent: #0284c7;
  --cyan: #38bdf8;
  --line: #d3e0ec;
  --gold: #d97706;
  --closing-bg: #edf5fb;
  --cover-bg: #0b1a28;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: #09131c;
  color: var(--ink);
  font-family: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
  overflow: hidden;
}
button { font: inherit; }

#stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1600px;
  height: 900px;
  transform: translate(-50%, -50%) scale(var(--scale, 1));
  transform-origin: center;
}

.slide {
  display: none;
  position: relative;
  width: 1600px;
  height: 900px;
  overflow: hidden;
  background: var(--paper);
  padding: 55px 70px;
}
.slide.active { display: block; }

.brandline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 18px;
  font-weight: 650;
  letter-spacing: 2px;
}
.brandline .brand {
  font-size: 25px;
  letter-spacing: -.5px;
  font-weight: 750;
  color: var(--ink);
}
.eyebrow {
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 2px;
}

h1, h2, p { margin: 0; }
h2 {
  font-weight: 700;
  letter-spacing: -1.6px;
  font-size: 50px;
  line-height: 1.12;
  margin: 22px 0 10px;
  max-width: 960px;
  color: var(--ink);
}
.lead {
  font-size: 23px;
  line-height: 1.34;
  color: var(--muted);
  max-width: 940px;
}

.feature-content {
  position: relative;
  margin-top: 22px;
  display: block;
}
.copy {
  padding-top: 2px;
  max-width: 880px;
}
.point {
  border-top: 1px solid var(--line);
  padding-top: 13px;
  margin-bottom: 17px;
}
.point h3 {
  margin: 0 0 5px;
  font-size: 24px;
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -.5px;
  color: var(--ink);
}
.point p {
  font-size: 20px;
  line-height: 1.32;
  color: var(--muted);
}

.caption {
  font-size: 18px;
  line-height: 1.35;
  color: var(--muted);
}
.footer {
  position: absolute;
  left: 70px;
  right: 70px;
  bottom: 22px;
  border-top: 1px solid var(--line);
  padding-top: 12px;
  display: flex;
  justify-content: space-between;
  gap: 40px;
  font-size: 16px;
  letter-spacing: .4px;
  color: var(--muted);
}

/* Portrait visual layout with Carousel */
.portrait-slide h2 { max-width: 960px; }
.portrait-slide .lead { max-width: 940px; }
.portrait-slide .copy { max-width: 880px; }
.portrait-slide .portrait-visual {
  position: absolute;
  right: 70px;
  top: 110px;
  width: 435px;
}
.portrait-slide > .caption {
  position: absolute;
  left: 70px;
  bottom: 58px;
  width: 900px;
  margin: 0;
}

/* Modern Tablet Carousel Frame */
.carousel {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 8;
  border-radius: 14px;
  overflow: hidden;
  background: #091522;
  box-shadow: 0 20px 48px rgba(13, 31, 45, 0.22);
  outline: 1px solid #c2d5e6;
  user-select: none;
}
.carousel-track {
  position: relative;
  width: 100%;
  height: 100%;
}
.carousel-item {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  transition: opacity .45s cubic-bezier(.4, 0, .2, 1), transform .45s cubic-bezier(.4, 0, .2, 1);
  transform: translateX(18px) scale(0.985);
}
.carousel-item.active {
  opacity: 1;
  visibility: visible;
  transform: translateX(0) scale(1);
  z-index: 2;
}
.carousel-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
/* For screenshot items, contain cleanly */
.carousel-item[data-contain="true"] img {
  object-fit: contain;
}

/* Pill state badge on top */
.state-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(11, 26, 40, 0.90);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(56, 189, 248, 0.45);
  border-radius: 8px;
  padding: 6px 12px;
  color: #f0f7ff;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .3px;
  z-index: 5;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
}
.state-badge .badge-title {
  color: var(--cyan);
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.state-badge .badge-count {
  color: #94a3b8;
  font-size: 12px;
  margin-left: 8px;
  flex-shrink: 0;
}

/* Controls overlay at bottom */
.carousel-nav {
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 6;
  background: rgba(11, 26, 40, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(211, 224, 236, 0.28);
  border-radius: 20px;
  padding: 4px 8px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
}
.carousel-btn {
  background: transparent;
  border: 0;
  color: #e2e8f0;
  cursor: pointer;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  transition: all .2s ease;
}
.carousel-btn:hover {
  background: rgba(56, 189, 248, 0.25);
  color: #38bdf8;
}
.carousel-dots {
  display: flex;
  gap: 6px;
  align-items: center;
}
.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.35);
  cursor: pointer;
  transition: all .25s ease;
  border: none;
  padding: 0;
}
.carousel-dot.active {
  width: 22px;
  background: var(--cyan);
}

/* Auto-cycle indicator bar */
.cycle-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  background: var(--cyan);
  width: 0%;
  z-index: 7;
  transition: width 0.1s linear;
}

/* Cover Slide (Deep Slate-Navy with Electric Cyan accents) */
.cover {
  background: linear-gradient(145deg, #0b1a28 0%, #11283e 100%);
  color: #f0f7ff;
}
.cover .brandline .brand { color: #ffffff; font-size: 30px; }
.cover .eyebrow, .cover .footer { color: #8bb2d4; }
.cover .footer { border-color: #1e3a54; }
.cover h1 {
  font-size: 78px;
  line-height: 1.05;
  letter-spacing: -3px;
  font-weight: 700;
  position: absolute;
  top: 205px;
  left: 70px;
  width: 720px;
  color: #ffffff;
}
.cover h1 span {
  display: block;
  color: var(--cyan);
}
.cover .tagline {
  position: absolute;
  top: 435px;
  left: 70px;
  width: 680px;
  font-size: 28px;
  line-height: 1.45;
  color: #d0e4f5;
}
.cover .portrait-visual {
  position: absolute;
  right: 70px;
  top: 110px;
  width: 435px;
}
.cover .carousel {
  outline-color: #234b6e;
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.6);
  background: #081520;
}
.cover .cover-caption {
  position: absolute;
  left: 70px;
  bottom: 58px;
  width: 900px;
  margin: 0;
  color: #9abedc;
  font-size: 18px;
  line-height: 1.35;
}
.cover .cover-tag {
  position: absolute;
  left: 70px;
  top: 605px;
  width: 680px;
  color: var(--cyan);
  font-size: 20px;
  line-height: 1.5;
  letter-spacing: .3px;
  font-weight: 600;
}

/* Closing Slide (Soft glacier slate-blue) */
.closing { background: var(--closing-bg); }
.closing .cta {
  margin-top: 14px;
  font-size: 23px;
  line-height: 1.25;
  font-weight: 700;
  color: #0369a1;
}
.closing .point {
  margin-bottom: 14px;
  padding-top: 12px;
  border-color: #c8dbeb;
}
.closing .point p { font-size: 20px; }
.closing .caption { max-width: 920px; }

/* Controls bar */
.controls {
  position: fixed;
  bottom: 9px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(13, 31, 45, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(56, 189, 248, 0.3);
  border-radius: 999px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  z-index: 100;
}
.controls button {
  background: transparent;
  color: #e2e8f0;
  border: 0;
  font-size: 15px;
  padding: 6px 10px;
  border-radius: 999px;
  cursor: pointer;
  transition: all .2s;
}
.controls button:hover {
  background: rgba(56, 189, 248, 0.2);
  color: var(--cyan);
}
.controls output {
  color: #cbd5e1;
  font-size: 14px;
  font-weight: 600;
  min-width: 60px;
  text-align: center;
}

@media print {
  @page {
    size: 1600px 900px;
    margin: 0;
  }
  html, body {
    width: 1600px !important;
    height: auto !important;
    overflow: visible !important;
    background: #ffffff !important;
  }
  #stage {
    position: static !important;
    transform: none !important;
    width: 1600px !important;
    height: auto !important;
  }
  .slide {
    display: block !important;
    position: relative !important;
    width: 1600px !important;
    height: 900px !important;
    page-break-inside: avoid;
    break-after: page;
    page-break-after: always;
  }
  .slide:last-child {
    break-after: auto;
    page-break-after: auto;
  }
  .controls, .carousel-nav, .cycle-progress, .state-badge {
    display: none !important;
  }
  .carousel-item {
    display: none;
  }
  .carousel-item:first-child {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }
}


    /* Custom overrides & Top Bar */
    :root {
      --bar-bg: rgba(9, 19, 28, 0.94);
      --cyan: #38bdf8;
    }
    html, body {
      user-select: none;
      -webkit-user-select: none;
    }

    .pres-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      background: var(--bar-bg);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(56, 189, 248, 0.2);
      z-index: 100;
      color: #f7fafd;
      transition: opacity 0.25s ease;
    }
    .pres-bar-left, .pres-bar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .pres-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 6px;
      color: #f7fafd;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .pres-back:hover {
      background: rgba(56, 189, 248, 0.22);
      border-color: var(--cyan);
      color: #fff;
    }
    .pres-title-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pres-app-title {
      font-weight: 700;
      font-size: 15px;
      letter-spacing: -0.01em;
      color: #fff;
    }
    .pres-chip {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 2px 7px;
      background: rgba(56, 189, 248, 0.16);
      color: var(--cyan);
      border-radius: 4px;
      font-weight: 600;
    }
    .tool-btn {
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.06);
      padding: 6px 10px;
      border-radius: 6px;
      color: #f7fafd;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .tool-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      border-color: var(--cyan);
    }

    #pres-container {
      position: absolute;
      top: 52px;
      left: 0;
      right: 0;
      bottom: 0;
      overflow: hidden;
    }
    #stage {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 1600px;
      height: 900px;
      transform: translate(-50%, -50%) scale(var(--scale, 1));
      transform-origin: center center;
      transition: transform 0.08s ease-out;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    }

    .controls {
      position: fixed;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bar-bg);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 6px 12px;
      border-radius: 30px;
      z-index: 90;
      color: #f7fafd;
      font-size: 13px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      transition: opacity .25s ease;
    }
    .controls.quiet { opacity: 0.18; }
    .controls:hover, .controls:focus-within { opacity: 1; }
    .controls button {
      color: inherit;
      background: transparent;
      border: 0;
      padding: 6px 14px;
      cursor: pointer;
      border-radius: 20px;
      font-weight: 600;
      transition: background 0.18s ease;
    }
    .controls button:hover, .controls button:focus-visible {
      background: #0c3350;
      outline: 1px solid var(--cyan);
    }
    .controls output {
      min-width: 60px;
      text-align: center;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .pres-progress {
      position: fixed;
      top: 52px;
      left: 0;
      height: 3px;
      background: var(--cyan);
      width: 0%;
      transition: width 0.25s ease;
      z-index: 101;
    }
    .keys-hint {
      font-size: 11px;
      color: #7d9cb3;
      margin-left: 6px;
      padding-left: 8px;
      border-left: 1px solid rgba(255, 255, 255, 0.15);
    }

    @media print {
      @page { size: 1600px 900px; margin: 0; }
      html, body {
        width: 1600px;
        height: auto;
        background: white;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .pres-bar, .controls, .pres-progress { display: none !important; }
      #pres-container { position: static; display: block; }
      #stage { position: static; transform: none; width: 1600px; height: auto; }
      .slide, .slide.active {
        display: block !important;
        break-after: page;
        page-break-after: always;
      }
      .slide:last-child { break-after: auto; page-break-after: auto; }
    }
  </style>
</head>
<body>
  <!-- Top Navigation Bar -->
  <header class="pres-bar">
    <div class="pres-bar-left">
      <a href="/ru/#apps" class="pres-back" id="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>Назад к резюме</span>
      </a>
      <div class="pres-title-wrap">
        <span class="pres-app-title">Rocksurv Classifier</span>
        <span class="pres-chip">10 слайдов · Карусели</span>
      </div>
    </div>
    <div class="pres-bar-right">
      <button class="tool-btn" id="full" title="На весь экран (F)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
      <button class="tool-btn" id="print" title="Печать / PDF (P)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
      </button>
    </div>
  </header>

  <div class="pres-progress" id="progress-bar"></div>

  <!-- Stage -->
  <div id="pres-container">
    <main id="stage">
      

<!-- SLIDE 1: COVER -->
<section class="slide cover active" aria-label="1. Rocksurv Classifier">
  <div class="brandline"><span class="brand">RS Classifier</span><span class="eyebrow">PRODUCT OVERVIEW</span></div>
  <h1>Rocksurv<span>Classifier</span></h1>
  <p class="tagline">Offline Precision Rock Classification<br>and Structural Field Analysis.</p>
  <p class="cover-tag">Standardized IUGS, Dunham &amp; Sibson Petrography for Field Geology</p>
  
  <div class="portrait-visual">
    <div class="carousel" data-slide="1">
      <div class="state-badge">
        <span class="badge-title"><span>✦</span> <span class="badge-label">Home Dashboard</span></span>
        <span class="badge-count">1 / 2</span>
      </div>
      <div class="carousel-track">
        <div class="carousel-item active" data-title="Home Dashboard" data-contain="true">
          <img src="/presentations/classifier/01-1600.webp" srcset="/presentations/classifier/01-600.webp 600w, /presentations/classifier/01-1000.webp 1000w, /presentations/classifier/01-1600.webp 1600w" sizes="(max-width: 900px) 90vw, 430px" alt="Rocksurv Classifier Home Dashboard with petrology and structural modules" fetchpriority="high" loading="eager" decoding="async">
        </div>
        <div class="carousel-item" data-title="Navigation Architecture" data-contain="true">
          <img src="/presentations/classifier/02-1600.webp" srcset="/presentations/classifier/02-600.webp 600w, /presentations/classifier/02-1000.webp 1000w, /presentations/classifier/02-1600.webp 1600w" sizes="(max-width: 900px) 90vw, 430px" alt="Navigation Drawer showing full 12-module petrological and structural hierarchy" fetchpriority="high" loading="eager" decoding="async">
        </div>
      </div>
      <div class="carousel-nav">
        <button class="carousel-btn prev" title="Previous state">❮</button>
        <div class="carousel-dots">
          <button class="carousel-dot active"></button>
          <button class="carousel-dot"></button>
        </div>
        <button class="carousel-btn next" title="Next state">❯</button>
      </div>
      <div class="cycle-progress"></div>
    </div>
  </div>
  
  <p class="cover-caption">Fast, standardized field geology tool for rigorous rock classification, ternary projections, and structural recalculation.</p>
  <footer class="footer"><span>Rocksurv Classifier · EN · September 2026</span><span>01 / 10</span></footer>
</section>

<!-- SLIDE 2: STRUCTURAL RECALCULATION & KINEMATICS -->
<section class="slide portrait-slide" aria-label="2. Real-time strike &amp; dip recalculation.">
