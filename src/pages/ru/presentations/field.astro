      <div class="deck" id="deck-en">
        <section class="slide cover active" aria-label="1. Rocksurv Field"><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">PRODUCT OVERVIEW</span></div><h1>Rocksurv<span>Field</span></h1><p class="tagline">A modern app for<br>geological mapping.</p><p class="cover-tag"></p><div class="hero-shot"><figure class="shot "><img src="/presentations/field/01-1920.webp" srcset="/presentations/field/01-800.webp 800w, /presentations/field/01-1280.webp 1280w, /presentations/field/01-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Rocksurv Field" fetchpriority="high" loading="eager" decoding="async"></figure><p class="caption">A complete toolkit for geological fieldwork.</p></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>01 / 12</span></footer></section><section class="slide " aria-label="2. Vector and raster data, together."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">01 / PROJECT CONTEXT</span></div><h2>Vector and raster data, together.</h2><p class="lead">Add local project data and explore its geological context.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Add project data</h3><p>Load vector and raster layers from GeoPackage files.</p></div><div class="point"><h3>Focus the map</h3><p>Control layer visibility, opacity and legends.</p></div><div class="point"><h3>Routes in context</h3><p>Import KML / KMZ routes alongside your maps.</p></div></div><div><figure class="shot "><img src="/presentations/field/02-1920.webp" srcset="/presentations/field/02-800.webp 800w, /presentations/field/02-1280.webp 1280w, /presentations/field/02-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="English map interface with geological layers and visibility controls" loading="lazy" decoding="async"></figure><p class="caption">Project maps in one GeoPackage, with convenient management inside the app.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>02 / 12</span></footer></section><section class="slide " aria-label="3. Three record types in an Active Session"><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">02 / ACTIVE SESSION</span></div><h2>Three record types in an Active Session</h2><p class="lead">Create field records in the active session and capture detailed geological data.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Observation</h3><p>Location, rock type, composition, textures, samples, photos and notes.</p></div><div class="point"><h3>Structure</h3><p>Planar and linear measurements, orientation and linked descriptions.</p></div><div class="point"><h3>Alteration and Mineralization</h3><p>Alteration types, minerals, intensity, form and geological context.</p></div></div><div><figure class="shot "><img src="/presentations/field/03-1920.webp" srcset="/presentations/field/03-800.webp 800w, /presentations/field/03-1280.webp 1280w, /presentations/field/03-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Active Session with Point Observation, Structures and Alt Mineral controls" loading="lazy" decoding="async"></figure><p class="caption">Keep every field record connected to its session and your survey organised.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>03 / 12</span></footer></section><section class="slide " aria-label="4. Compass, GPS and profile lines"><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">03 / FIELD ORIENTATION</span></div><h2>Compass, GPS and profile lines</h2><p class="lead">Combine direction, position and map distances for field orientation.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Compass heading</h3><p>Read the heading in degrees and cardinal directions, with a quality indicator.</p></div><div class="point"><h3>GPS context</h3><p>Combine heading with GPS position and reported accuracy to orient on the map.</p></div><div class="point"><h3>Profile line / ruler</h3><p>Trace a profile line on the map and measure the distance of each segment.</p></div></div><div><figure class="shot "><img src="/presentations/field/04-1920.webp" srcset="/presentations/field/04-800.webp 800w, /presentations/field/04-1280.webp 1280w, /presentations/field/04-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Live compass and ruler with a profile line and segment distance labels on a geological map" loading="lazy" decoding="async"></figure><p class="caption">Keep your bearing and plan profile lines directly on the geological map.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>04 / 12</span></footer></section><section class="slide portrait-slide" aria-label="5. Smart classification, focused fields."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">04 / FIELD OBSERVATIONS</span></div><h2>Smart classification, focused fields.</h2><p class="lead">Rock type guides classification and the choices available in each record.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Smart rock naming</h3><p>Rules suggest names from rock type and entered composition.</p></div><div class="point"><h3>Rock-specific choices</h3><p>Filter textures, components, names and characteristics by type.</p></div><div class="point"><h3>Linked descriptions</h3><p>Build editable point descriptions with photo references.</p></div></div></div><div class="portrait-visual"><figure class="shot portrait"><img src="/presentations/field/05-1600.webp" srcset="/presentations/field/05-600.webp 600w, /presentations/field/05-1000.webp 1000w, /presentations/field/05-1600.webp 1600w" sizes="(max-width: 900px) 90vw, 430px" alt="Actual tablet screen with intrusive QAPF rock components and the calculated Monzogranite name" loading="lazy" decoding="async"></figure></div><p class="caption">Relevant choices and rock-name suggestions help you describe geology with confidence.</p><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>05 / 12</span></footer></section><section class="slide portrait-slide" aria-label="6. Measured structures, linked descriptions."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">05 / STRUCTURAL GEOLOGY</span></div><h2>Measured structures, linked descriptions.</h2><p class="lead">Orient a planar feature and carry linked photo details into its description.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Planar measurements</h3><p>Enter dip direction and angle; strike is calculated by the right-hand rule.</p></div><div class="point"><h3>Automatic references</h3><p>The linked photo ID, PH01, is inserted into the structure description.</p></div><div class="point"><h3>Editable description</h3><p>Apply the generated text, then complete or refine the details.</p></div></div></div><div class="portrait-visual"><figure class="shot portrait"><img src="/presentations/field/06-1600.webp" srcset="/presentations/field/06-600.webp 600w, /presentations/field/06-1000.webp 1000w, /presentations/field/06-1600.webp 1600w" sizes="(max-width: 900px) 90vw, 430px" alt="Current tablet screen: planar contact measurement, calculated strike and linked photo reference PH01" loading="lazy" decoding="async"></figure></div><p class="caption">Linked photos bring the context into your descriptions, so you can focus on interpretation.</p><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>06 / 12</span></footer></section><section class="slide " aria-label="7. Photos with geological detail."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">06 / PHOTO DOCUMENTATION</span></div><h2>Photos with geological detail.</h2><p class="lead">Detailed captions keep field evidence useful for office interpretation.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Detailed photo notes</h3><p>Geological features, scale and viewing direction.</p></div><div class="point"><h3>Context in templates</h3><p>Insert rock, texture and structure values into descriptions.</p></div><div class="point"><h3>Connected records</h3><p>Photo and sketch references link point and structure descriptions.</p></div></div><div><figure class="shot "><img src="/presentations/field/07-1280.webp" srcset="/presentations/field/07-640.webp 640w, /presentations/field/07-1280.webp 1280w" sizes="(max-width: 900px) 90vw, 960px" alt="Presentation composite: tablet photo editor with an enlarged geological photograph on the left and its description on the right" loading="lazy" decoding="async"></figure><p class="caption">Turn each field photo into a clear geological record that stays useful back in the office.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>07 / 12</span></footer></section><section class="slide " aria-label="8. Describe what you see in the field."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">07 / ALTERATION &amp; MINERALIZATION</span></div><h2>Describe what you see in the field.</h2><p class="lead">Document alteration and mineralization with dedicated records.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Alteration detail</h3><p>Record type, intensity and form.</p></div><div class="point"><h3>Field terminology</h3><p>Enter a value or select a suggestion.</p></div><div class="point"><h3>Spatial context</h3><p>Link to an observation and retain separate coordinates.</p></div></div><div><figure class="shot "><img src="/presentations/field/08-1920.webp" srcset="/presentations/field/08-800.webp 800w, /presentations/field/08-1280.webp 1280w, /presentations/field/08-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Alteration and mineralization editor showing type, intensity and form fields" loading="lazy" decoding="async"></figure><p class="caption">Capture the details that matter while the outcrop is right in front of you.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>08 / 12</span></footer></section><section class="slide " aria-label="9. Keep elevation available offline."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">08 / OFFLINE TERRAIN</span></div><h2>Keep elevation available offline.</h2><p class="lead">Choose a terrain source and prepare its coverage before fieldwork.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Your own contour data</h3><p>Add your contour lines — RS Field automatically determines elevation from them.</p></div><div class="point"><h3>DEM from open sources</h3><p>Choose your area and download available DEM data directly in the app.</p></div><div class="point"><h3>Ready for the field</h3><p>Use downloaded DEM offline, with GNSS as an additional elevation source.</p></div></div><div><figure class="shot "><img src="/presentations/field/09-1920.webp" srcset="/presentations/field/09-800.webp 800w, /presentations/field/09-1280.webp 1280w, /presentations/field/09-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Current tablet screen for choosing Copernicus GLO-30 and defining DEM coverage" loading="lazy" decoding="async"></figure><p class="caption">Prepare terrain before departure and keep elevations at hand beyond mobile coverage.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>09 / 12</span></footer></section><section class="slide " aria-label="10. Make field data ready for review."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">09 / FIELD TO OFFICE</span></div><h2>Make field data ready for review.</h2><p class="lead">Export a field session as a structured handover for the office.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Excel workbook</h3><p>Deliver structured records in XLSX format.</p></div><div class="point"><h3>Linked media</h3><p>Include photos and sketches in the ZIP package.</p></div><div class="point"><h3>Validation context</h3><p>Carry a validation report with the export.</p></div></div><div><figure class="shot "><img src="/presentations/field/10-1920.webp" srcset="/presentations/field/10-800.webp 800w, /presentations/field/10-1280.webp 1280w, /presentations/field/10-1920.webp 1920w" sizes="(max-width: 900px) 90vw, 960px" alt="Field session export dialog in the Android app" loading="lazy" decoding="async"></figure><p class="caption">Hand over observations, media and quality checks together for a smoother office review.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>10 / 12</span></footer></section><section class="slide language-slide" aria-label="11. An interface for international teams."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">10 / LANGUAGES &amp; PLATFORMS</span></div><h2>An interface for international teams.</h2><p class="lead">Language selection is built into the application.</p><div class="feature-content"><div class="copy"><div class="point"><h3>Interface localization</h3><p>Switch between English, Russian and Arabic.</p></div><div class="point"><h3>Consistent field terms</h3><p>Geological dictionaries retain their project terminology.</p></div><div class="point"><h3>Platform availability</h3><p>Android build demonstrated. iOS release status to be confirmed.</p></div><div class="platforms"><div class="platform"><div class="platform-art android"><img src="/presentations/field/assets/android.svg" alt="Android" loading="lazy"></div><span>Android</span></div><div class="platform"><div class="platform-art ios"><img src="/presentations/field/assets/apple.svg" alt="iOS" loading="lazy"></div><span>iOS</span></div></div></div><div><div class="languages"><div class="lang-row"><img src="/presentations/field/assets/flag_gb.svg" alt="" class="flag-background" loading="lazy"><span>EN</span><strong lang="en" class="en" dir="ltr">English</strong></div><div class="lang-row"><img src="/presentations/field/assets/flag_ru.svg" alt="" class="flag-background" loading="lazy"><span>RU</span><strong lang="ru" class="ru" dir="ltr">Русский</strong></div><div class="lang-row"><img src="/presentations/field/assets/flag_sa.svg" alt="" class="flag-background" loading="lazy"><span>AR</span><strong lang="ar" class="ar" dir="rtl">العربية</strong></div></div><p class="caption">A familiar interface language helps international teams get straight to fieldwork.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>11 / 12</span></footer></section><section class="slide closing" aria-label="12. Your ultimate field companion."><div class="brandline"><span class="brand">RS Field</span><span class="eyebrow">11 / YOUR FIELD COMPANION</span></div><h2>Your ultimate field companion.</h2><p class="lead">Rocksurv Field brings your geological workflow together in one app.</p><div class="feature-content"><div class="copy"><div class="point"><h3>See the full picture</h3><p>Project maps, terrain and navigation at your fingertips.</p></div><div class="point"><h3>Capture every detail</h3><p>Observations, structures and photos connected in one workflow.</p></div><div class="point"><h3>Keep work moving</h3><p>Collect data in the field and bring organised results back to the office.</p></div><p class="cta">Focus on the geology. RS Field is at your side.</p></div><div><figure class="shot "><img src="/presentations/field/11-1280.webp" srcset="/presentations/field/11-640.webp 640w, /presentations/field/11-1280.webp 1280w" sizes="(max-width: 900px) 90vw, 960px" alt="AI-edited field photograph based on the author’s photo: geologist seen from behind using RS Field on a tablet." loading="lazy" decoding="async"></figure><p class="caption">From the first outcrop to the final report.</p></div></div><footer class="footer"><span>Rocksurv Field · EN · September 2026</span><span>12 / 12</span></footer></section>
      </div>
    </main>
  </div>

  <!-- Bottom Navigation Bar -->
  <nav class="controls" aria-label="Управление слайдами">
    <button id="prev" aria-label="Предыдущий слайд">←</button>
    <output id="counter" aria-live="polite">01 / 12</output>
    <button id="next" aria-label="Следующий слайд">→</button>
    <span class="keys-hint">← → или Пробел · F весь экран</span>
  </nav>

  <script is:inline>
    let currentLang = 'ru';
    const deckRu = document.getElementById('deck-ru');
    const deckEn = document.getElementById('deck-en');
    const btnRu = document.getElementById('btn-lang-ru');
    const btnEn = document.getElementById('btn-lang-en');
    const counter = document.getElementById('counter');
    const bar = document.querySelector('.controls');
    const progressBar = document.getElementById('progress-bar');
    const backLink = document.getElementById('back-link');

    // Smart back: if user arrived from the same site, use history.back()
    if (document.referrer && document.referrer.includes(window.location.host)) {
      backLink.addEventListener('click', (e) => {
        e.preventDefault();
        history.back();
      });
    }

    function getSlides() {
      const activeDeck = currentLang === 'ru' ? deckRu : deckEn;
      return [...activeDeck.querySelectorAll('.slide')];
    }

    let slides = getSlides();
    let index = Math.min(slides.length - 1, Math.max(0, parseInt(location.hash.slice(1) || '1', 10) - 1 || 0));

    function setLang(lang) {
      currentLang = lang;
      if (lang === 'ru') {
        deckRu.classList.add('active-deck');
        deckEn.classList.remove('active-deck');
        btnRu.classList.add('active');
        btnEn.classList.remove('active');
        document.documentElement.lang = 'ru';
      } else {
        deckRu.classList.remove('active-deck');
        deckEn.classList.add('active-deck');
        btnRu.classList.remove('active');
        btnEn.classList.add('active');
        document.documentElement.lang = 'en';
      }
      slides = getSlides();
      show(index);
    }

    btnRu.addEventListener('click', () => setLang('ru'));
    btnEn.addEventListener('click', () => setLang('en'));

    // Check URL query param for lang
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('lang') === 'en') {
      setLang('en');
    }

    function show(n) {
      index = Math.min(slides.length - 1, Math.max(0, n));
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === index);
        s.setAttribute('aria-hidden', i !== index);
      });
      const num = String(index + 1).padStart(2, '0');
      const total = String(slides.length).padStart(2, '0');
      counter.textContent = `${num} / ${total}`;
      if (progressBar) {
        progressBar.style.width = `${((index + 1) / slides.length) * 100}%`;
      }
      history.replaceState(null, '', `#${index + 1}`);
    }

    function fit() {
      const headerH = 52;
      const margin = 20;
      const availW = window.innerWidth - margin * 2;
      const availH = window.innerHeight - headerH - margin * 2;
      const scale = Math.min(availW / 1600, availH / 900, 1.25);
      document.documentElement.style.setProperty('--scale', Math.max(scale, 0.2).toString());
    }
    window.addEventListener('resize', fit);
    fit();
    show(index);

    document.getElementById('prev').onclick = () => show(index - 1);
    document.getElementById('next').onclick = () => show(index + 1);
    document.getElementById('print').onclick = () => window.print();

    async function toggleFullscreen() {
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else await document.documentElement.requestFullscreen();
      } catch (e) {
        console.warn('Fullscreen request failed:', e);
      }
    }
    document.getElementById('full').onclick = toggleFullscreen;

    window.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (['ArrowRight', 'PageDown', ' '].includes(e.key)) {
        e.preventDefault();
        show(index + 1);
      }
      if (['ArrowLeft', 'PageUp'].includes(e.key)) {
        e.preventDefault();
        show(index - 1);
      }
      if (e.key === 'Home') { e.preventDefault(); show(0); }
      if (e.key === 'End') { e.preventDefault(); show(slides.length - 1); }
      if (e.key.toLowerCase() === 'f') toggleFullscreen();
      if (e.key.toLowerCase() === 'p') window.print();
      if (e.key === 'Escape') {
        if (!document.fullscreenElement) {
          window.location.href = '/ru/#apps';
        }
      }
    });

    // Quiet controls on inactivity
    let timer;
    function wake() {
      bar.classList.remove('quiet');
      clearTimeout(timer);
      timer = setTimeout(() => bar.classList.add('quiet'), 3000);
    }
    window.addEventListener('pointermove', wake);
    wake();

    // Touch swipe gestures
    let touchStartX = 0;
    let touchStartY = 0;
    window.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });
    window.addEventListener('touchend', (e) => {
      const diffX = e.changedTouches[0].screenX - touchStartX;
      const diffY = e.changedTouches[0].screenY - touchStartY;
      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) show(index + 1);
        else show(index - 1);
      }
    }, { passive: true });
  </script>
