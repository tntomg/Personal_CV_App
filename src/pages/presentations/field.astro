---
// Redirect to localized presentation
---
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Redirecting to Rocksurv Field presentation...</title>
  <script is:inline>
    (function() {
      try {
        var stored = localStorage.getItem('preferred-lang');
        if (stored === 'en') { window.location.replace('/en/presentations/field/'); return; }
        if (stored === 'ru') { window.location.replace('/ru/presentations/field/'); return; }
      } catch (e) {}
      var lang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
      if (/^ru\b|^be\b|^uk\b/i.test(lang)) {
        window.location.replace('/ru/presentations/field/');
      } else {
        window.location.replace('/en/presentations/field/');
      }
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url=/ru/presentations/field/">
  </noscript>
</head>
<body>
  <p>Redirecting to <a href="/ru/presentations/field/">Russian</a> or <a href="/en/presentations/field/">English</a> presentation...</p>
</body>
</html>
