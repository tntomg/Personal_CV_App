---
import photoSizes from '../data/photo-sizes.json';
import Icon from './Icon.astro';

interface Photo {
  slug: string;
  kind: 'photo' | 'map' | 'document' | 'chart' | 'thin-section';
  date?: string;
  alt: string;
  caption: string;
}

const MONTHS = ['январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль', 'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь'];
// "2011-11" -> "ноябрь 2011", "2019" -> "2019".
const dateLabel = (date?: string) => {
  if (!date) return '';
  const [year, month] = date.split('-');
  return month ? `${MONTHS[Number(month) - 1]} ${year}` : year;
};

interface Props {
  id: string;
  label: string;
  photos: Photo[];
  note?: string;
}

interface Size {
  width: number;
  height: number;
  smallWidth: number;
  color: string;
  fullWidth?: number;
  fullHeight?: number;
}

const { id, label, photos, note } = Astro.props;
const sizes: Record<string, Size> = photoSizes;
const missing = photos.filter((photo) => !sizes[photo.slug]).map((photo) => photo.slug);
if (missing.length > 0) {
  throw new Error(`Нет веб-копий фотографий: ${missing.join(', ')}. Запустите python scripts/prepare_media.py`);
}

const count = photos.length;
const viewportId = `gallery-${id}`;
const src = (slug: string, size: 160 | 640 | 1280 | 1920) => `/images/experience/${slug}-${size}.webp`;
// Every frame takes the photo's own proportions (width / height), so nothing is cropped or letterboxed.
const ratio = (photo: Photo) => (sizes[photo.slug].width / sizes[photo.slug].height).toFixed(4);
// Maps, documents and charts sit on a paper mat; photos fill their frame edge to edge.
const matted = (photo: Photo) => photo.kind !== 'photo';
const viewerSrcset = (photo: Photo) => {
  const size = sizes[photo.slug];
  const large = `${src(photo.slug, 1280)} ${size.width}w`;
  return size.fullWidth ? `${large}, ${src(photo.slug, 1920)} ${size.fullWidth}w` : large;
};
---
<div class:list={['gallery', { 'is-single': count === 1 }]} data-gallery data-reveal="wipe" style={`--r-first:${ratio(photos[0])};--r-last:${ratio(photos[count - 1])}`}>
  <div class="gallery-frame">
    <div class="gallery-viewport" id={viewportId} data-viewport role="region" aria-roledescription="карусель" aria-label={label} tabindex="0">
      {photos.map((photo, index) => {
        const { width, height, smallWidth, color } = sizes[photo.slug];
        const when = dateLabel(photo.date);
        return (
          <figure class="gallery-slide" data-slide role="group" aria-roledescription="слайд" aria-label={`${index + 1} из ${count}`} style={`--c:${color};--r:${ratio(photo)}`}>
            <a
              class:list={['gallery-media', `kind-${photo.kind}`, { 'fit-contain': matted(photo) }]}
              href={src(photo.slug, 1280)}
              data-zoom
              data-index={index}
              data-caption={when ? `${photo.caption}, ${when}` : photo.caption}
              data-alt={photo.alt}
              data-width={width}
              data-height={height}
              data-srcset={viewerSrcset(photo)}
              aria-label={`Открыть крупно: ${photo.alt}`}
              draggable="false"
            >
              <img
                src={src(photo.slug, 640)}
                srcset={`${src(photo.slug, 640)} ${smallWidth}w, ${src(photo.slug, 1280)} ${width}w`}
                sizes="(max-width: 1100px) 90vw, 46vw"
                width={width}
                height={height}
                loading="lazy"
                decoding="async"
                alt={photo.alt}
                draggable="false"
              />
              {photo.date && <time class="photo-date" datetime={photo.date} aria-hidden="true">{when}</time>}
              <span class="zoom-hint" aria-hidden="true"><Icon name="arrows-out" /></span>
            </a>
            <figcaption>{photo.caption}{when && <span class="visually-hidden">, {when}</span>}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
  {count > 1 && (
    <div class="gallery-controls" data-controls hidden>
      <button type="button" class="round-button" data-prev aria-controls={viewportId} aria-label="Предыдущее фото"><Icon name="caret-left" /></button>
      <button type="button" class="round-button" data-next aria-controls={viewportId} aria-label="Следующее фото"><Icon name="caret-right" /></button>
      {count < 4 && <div class="gallery-dots" aria-hidden="true">{photos.map(() => <span />)}</div>}
      <p class="gallery-count" data-status aria-live="polite"><b>1</b> из {count}</p>
    </div>
  )}
  {count >= 4 && (
    <div class="gallery-thumbs" data-thumbs hidden>
      {photos.map((photo, index) => (
        <button type="button" data-thumb={index} aria-label={`Фото ${index + 1}: ${photo.caption}`} aria-current={index === 0 ? 'true' : 'false'} style={`--c:${sizes[photo.slug].color};--r:${ratio(photo)}`}>
          <img src={src(photo.slug, 160)} alt="" width={Math.round(48 * Number(ratio(photo)))} height="48" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
  {note && <p class="gallery-note">{note}</p>}
</div>
