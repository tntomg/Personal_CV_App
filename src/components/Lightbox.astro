---
import Icon from './Icon.astro';
---
<dialog class="lightbox" data-lightbox aria-label="Просмотр фотографии">
  <div class="lb-top">
    <p class="lb-count" data-lb-count aria-live="polite"></p>
    <button type="button" class="round-button lb-close" data-lb-close aria-label="Закрыть просмотр"><Icon name="close" /></button>
  </div>
  <div class="lb-stage" data-lb-stage>
    <button type="button" class="round-button lb-nav lb-prev" data-lb-prev aria-label="Предыдущее фото"><Icon name="arrow-left" /></button>
    <button type="button" class="round-button lb-nav lb-next" data-lb-next aria-label="Следующее фото"><Icon name="arrow-right" /></button>
  </div>
  <p class="lb-caption" data-lb-caption></p>
</dialog>
